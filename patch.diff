+          colorIdx++;
+        }
+        categoryMap[tx.category].value += Math.abs(tx.amount);
+      }
+    });
+
+    const categoryData = Object.values(categoryMap).sort((a, b) => b.value - a.value);
+
+    // Group for trend chart (by day)
